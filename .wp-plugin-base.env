FOUNDATION_RELEASE_SOURCE_PROVIDER=github-release
FOUNDATION_RELEASE_SOURCE_REFERENCE=MatthiasReinholz/wp-plugin-base
FOUNDATION_VERSION=v1.10.2
AUTOMATION_PROFILE=managed
AUTOMATION_PROVIDER=github
DEFAULT_BRANCH=main
CODEOWNERS_REVIEWERS=@MatthiasReinholz
PLUGIN_NAME="Packing Lists for WooCommerce"
PLUGIN_SLUG=packing-lists-for-woocommerce
MAIN_PLUGIN_FILE=packing-lists-for-woocommerce.php
README_FILE=readme.txt
ZIP_FILE=packing-lists-for-woocommerce.zip
PHP_VERSION=8.1
NODE_VERSION=22
VERSION_CONSTANT_NAME=PACKING_LISTS_FOR_WOOCOMMERCE_VERSION
WORDPRESS_READINESS_ENABLED=true
WORDPRESS_TEST_PLUGINS=woocommerce@11.1.2
WORDPRESS_QUALITY_PACK_ENABLED=true
WORDPRESS_SECURITY_PACK_ENABLED=true
PLUGIN_RUNTIME_UPDATE_PROVIDER=none
REST_OPERATIONS_PACK_ENABLED=false
ADMIN_UI_PACK_ENABLED=false
PACKAGE_INCLUDE=packing-lists-for-woocommerce.php,uninstall.php,includes,lib,readme.txt,LICENSE,THIRD-PARTY-NOTICES.md,composer.json,composer.lock
PACKAGE_EXCLUDE=lib/**/README*,lib/**/CHANGELOG*,lib/**/UPGRADING*,lib/**/RELEASE*
BUILD_SCRIPT=tools/build-runtime.sh
PHPSTAN_MEMORY_LIMIT=1G
# Reserved, guarded URL for disposable WooCommerce tests only.
EXTRA_ALLOWED_HOSTS=packing.test
